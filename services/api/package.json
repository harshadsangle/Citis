{
  "name": "@citis/api",
  "version": "0.1.0",
  "private": true,
  "description": "CITIS Education Platform foundation API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node --project tsconfig.json src/main.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "test": "node --import tsx --test $(find src -name '*.spec.ts' -print)",
    "test:auth": "node --import tsx --test src/modules/auth/auth.regression.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  }
}