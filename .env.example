NEXT_PUBLIC_SITE_URL=http://localhost:5000
# Backend REST API base URL — required for admin pages and analytics.
# Leave blank (or omit) to run in frontend-only mode; public forms will use
# mailto: drafts and admin data pages will display a "not configured" notice.
NEXT_PUBLIC_API_URL=
# Optional map marker overrides
NEXT_PUBLIC_MAP_LAT=12.9716
NEXT_PUBLIC_MAP_LNG=77.5946
# Public support inbox used by Contact Us / newsletter / partner forms
NEXT_PUBLIC_SUPPORT_EMAIL=support@citis.in
# Razorpay server-only configuration. Never expose these in frontend variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional for sandboxing or a provider-compatible test endpoint.
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# Local LMS stack (API + portals). Required for `npm run db:setup-local` and `npm run dev`.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/citis
# Demo account passwords used by the seed scripts and the learner auth regression test.
DEMO_ADMIN_PASSWORD=
DEMO_INSTRUCTOR_PASSWORD=
DEMO_LEARNER_PASSWORD=
# Set when port 4000 is already in use; portals and the public site follow it.
API_PORT=4000
