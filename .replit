modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["chromium", "freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild", "yt-dlp"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-all-dev.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 4000
externalPort = 3000

[[ports]]
localPort = 4101
externalPort = 3001

[[ports]]
localPort = 4102
externalPort = 3003

[[ports]]
localPort = 4103
externalPort = 3002

[[ports]]
localPort = 4400
externalPort = 4200

[[ports]]
localPort = 4901
externalPort = 5173

[[ports]]
localPort = 4902
externalPort = 6000

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.production]
WEB_ORIGIN = "https://citis-institution-admin-pbhs.vercel.app,https://citis-institution-admin.vercel.app,https://www.citisinfotech.in,https://lms.citisinfotech.in"

[userenv.development]
NEXT_PUBLIC_API_URL = "http://localhost:4000/api/v1"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start", "--workspace", "@citis/api"]
build = ["npm", "run", "build:api"]
