# This root file is a reference only; services load their own environment files.
# Copy each service template before running it:
#
#   cp frontend/.env.example frontend/.env.local
#   cp backend/.env.example backend/.env
#   cp strapi-cms/.env.example strapi-cms/.env
#
# Docker Compose reads docker/.env when present. Its checked-in defaults are
# suitable for local development; set secure secrets before shared deployment.
