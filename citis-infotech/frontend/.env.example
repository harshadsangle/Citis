NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend REST API base URL — required for admin pages and analytics.
# Leave blank (or omit) to run in frontend-only mode; public forms will use
# mailto: drafts and admin data pages will display a "not configured" notice.
NEXT_PUBLIC_API_URL=
# Optional map marker overrides
NEXT_PUBLIC_MAP_LAT=12.9716
NEXT_PUBLIC_MAP_LNG=77.5946
# Public support inbox used by Contact Us / newsletter / partner forms
NEXT_PUBLIC_SUPPORT_EMAIL=support@citis.in
