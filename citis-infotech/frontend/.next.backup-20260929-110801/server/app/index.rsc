images/clients/aditya-horizon-school-junior-college.png"},{"name":"Vidya Valley","logo":"/images/clients/vidya-valley.png"},{"name":"Jnana Prabodhini","logo":"/images/clients/jnana-prabodhini.png"},{"name":"Podar International School","logo":"/images/clients/podar-international-school.png"}]}]}]]}]]}]
