31:["$","section",null,{"className":"border-y border-border bg-[#e8edf5] py-16 dark:bg-slate-900","children":["$","div",null,{"className":"container-site","children":[["$","h2",null,{"className":"font-heading text-3xl font-semibold","children":"Continue exploring"}],["$","div",null,{"className":"mt-8 grid gap-5 md:grid-cols-3","children":[["$","div","how-nep-2020-empowers-teachers",{"className":"surface rounded-2xl transition-shadow duration-200 group h-full text-slate-900 dark:text-card-foreground","children":["$","div",null,{"className":"sm:px-6 sm:pb-6 p-6","children":[["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors border-border text-foreground","children":"NEP 2020"}],["$","h3",null,{"className":"mt-4 font-heading text-lg font-semibold text-slate-900 dark:text-card-foreground","children":"How does NEP 2020 Intend to Empower Teachers?"}],["$","p",null,{"className":"mt-3 line-clamp-2 text-sm leading-6 text-slate-600 dark:text-muted-foreground","children":"Teachers constitute a fundamental element of the education ecosystem and society at large. A responsible, knowledgeable, and engaged teacher mirrors his attributes, qualities, and approach in his students. With his…"}],["$","$L1a",null,{"href":"/highlights/blogs/how-nep-2020-empowers-teachers","className":"mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary dark:text-primary","children":["Read article",["$","$L1b",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right size-4 transition-transform group-hover:translate-x-1"}]]}]]}]}],["$","div","app-development-opportunity-for-high-school-students",{"className":"surface rounded-2xl transition-shadow duration-200 group h-full text-slate-900 dark:text-card-foreground","children":["$","div",null,{"className":"sm:px-6 sm:pb-6 p-6","children":[["$","span",null,{"cla