th",{"d":"M16 2v3","key":"otl347"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2","key":"h1oib"}],["path",{"d":"M3 9h18","key":"1pudct"}],["path",{"d":"M8 13h.01","key":"1sbv64"}],["path",{"d":"M12 13h.01","key":"y0uutt"}],["path",{"d":"M16 13h.01","key":"wip0gl"}],["path",{"d":"M8 17h.01","key":"p3bg7i"}],["path",{"d":"M12 17h.01","key":"p32p05"}],["path",{"d":"M16 17h.01","key":"ql8jdd"}]],"className":"lucide-calendar-days size-4"}],"17 March 2022"]}],["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L1a",null,{"ref":"$undefined","iconNode":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"M12 6v6l4 2","key":"mmk7yg"}]],"className":"lucide-clock size-4"}],"4 min read"]}]]}]]}]]}]]}],["$","div",null,{"className":"bg-[#e8edf5] dark:bg-slate-900","children":["$","div",null,{"className":"container-site grid gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-16 lg:py-20","children":[["$","div",null,{"className":"mx-auto max-w-3xl","children":[[["$","section","Overview",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Overview"}],[["$","p","AI is an ever-evolving and growing technology. Yes. It has undoubtedly rendered a lot of existing jobs redundant. However, according to a 2017 research from IDC, released by SalesForce, AI is projected to create 823,734 jobs by 2021 (Published on Analytics Insight) – a number that is way higher than the jobs that machine learning and automation turned obsolete. Accordingly, if you are interested in an AI career, here are the top AI jobs in 2021.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"AI is an ever-evolving and growing technology. Yes. It has undoubtedly rendered a lot of existing jobs redundant. However, according to a 2017 research from IDC, released by SalesForce, AI is projected to create 823,734 jobs by 2021 (Published on Analytics Insight) – a number that is way higher than the jobs that machine learning and automation turned obsolete. Accordingly, if you are interested in an AI career, here are the top AI jobs in 2021."}]]]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20"],"$L21"]}],"$L22"]}]}]]}],"$L23","$L24"]
1b:["$","section","Big Data Engineer/ Architect",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Big Data Engineer/ Architect"}],[["$","p","Big Data engineers and architects develop and plan Big Data environment on Hadoop and Spark systems. Working as a Big Data Engineer requires involves high stakes. It is a responsible position that demands a Ph.D. in Mathematics or Computer Science. Besides, experience in data migration, data visualization, and data mining, coupled with a significant one in Scala, Python, C++, and Java, are equally crucial qualifications.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Big Data engineers and architects develop and plan Big Data environment on Hadoop and Spark systems. Working as a Big Data Engineer requires involves high stakes. It is a responsible position that demands a Ph.D. in Mathematics or Computer Science. Besides, experience in data migration, data visualization, and data mining, coupled with a significant one in Scala, Python, C++, and Java, are equally crucial qualifications."}]]]}]
1c:["$","section","Research Scientist",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Research Scientist"}],[["$","p","Research Scientist is another in-demand AI job in 2021. It requires you to be an expert in multiple areas, including machine learning, computational statistics, deep learning, and applied mathematics. Additionally, the job demands experience in NLP, reinforcement learning, and graphical model. Most employers look for candidates with an advanced degree in a relevant discipline. Besides, knowledge of AI is an added advantage.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Research Scientist is another in-demand AI job in 2021. It requires you to be an expert in multiple areas, including machine learning, computational statistics, deep learning, and applied mathematics. Additionally, the job demands experience in NLP, reinforcement learning, and graphical model. Most employers look for candidates with an advanced degree in a relevant discipline. Besides, knowledge of AI is an added advantage."}]]]}]
1d:["$","section","Business Intelligence (BI) Developer",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Business Intelligence (BI) Developer"}],[["$","p","BI developers analyze complex datasets, identify market trends and patterns to help their company gain vital insights that support informed decision-making and business growth. They use cloud-based data platforms to design, model, and maintain complex data. Working as a BI developer requires a bachelor’s degree, some practical experience, and relevant certifications. Besides, knowledge of SQL and BI technologies proves critical.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"BI developers analyze complex datasets, identify market trends and patterns to help their company gain vital insights that support informed decision-making and business growth. They use cloud-based data platforms to design, model, and maintain complex data. Working as a BI developer requires a bachelor’s degree, some practical experience, and relevant certifications. Besides, knowledge of SQL and BI technologies proves critical."}]]]}]
1e:["$","section","Data Scientist",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Data Scientist"}],[["$","p","Data Scientist is one of the most trending jobs across the AI employment horizon. As a data scientist, you deal with massive and intricate datasets and leverage ML and Predictive Analytics to deliver the desired results. Additionally, you also develop algorithms that allow you to gather and clean substantial datasets and prepare them for analysis. The job demands familiarity with Hive, Pig, Spark, Hadoop, Python, Scala, Perl, and SQL.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Data Scientist is one of the most trending jobs across the AI employment horizon. As a data scientist, you deal with massive and intricate datasets and leverage ML and Predictive Analytics to deliver the desired results. Additionally, you also develop algorithms that allow you to gather and clean substantial datasets and prepare them for analysis. The job demands familiarity with Hive, Pig, Spark, Hadoop, Python, Scala, Perl, and SQL."}]]]}]
1f:["$","section","Machine Learning Engineer",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Machine Learning Engineer"}],[["$","p","Machine Learning plays a critical technical role in AI. ML engineers deal with massive datasets. They apply predictive models to optimize NLP and ensure efficiency across ML projects. The job position requires experience in Agile development practices, Eclipse, IntelliJ, Java, Scala, Python, experience in neural networks, and deep learning. It demands a comprehensive understanding of programming languages and AI programming as well.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Machine Learning plays a critical technical role in AI. ML engineers deal with massive datasets. They apply predictive models to optimize NLP and ensure efficiency across ML projects. The job position requires experience in Agile development practices, Eclipse, IntelliJ, Java, Scala, Python, experience in neural networks, and deep learning. It demands a comprehensive understanding of programming languages and AI programming as well."}]]]}]
20:["$","section","CITIS – Your AI Learning Partner",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"CITIS – Your AI Learning Partner"}],[["$","p","CITIS is one of the leading EduTech partners in India. Its work revolves around developing learning programs for various competencies such as AI, ML, Robotics, etc., and further, help educationists across the country implement them through efficient incubation centers. For more information on CITIS, and its various EduTech implementation programs, call at +91 20 2567 70 60 or write an email to support@citis.in.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"CITIS is one of the leading EduTech partners in India. Its work revolves around developing learning programs for various competencies such as AI, ML, Robotics, etc., and further, help educationists across the country implement them through efficient incubation centers. For more information on CITIS, and its various EduTech implementation programs, call at +91 20 2567 70 60 or write an email to support@citis.in."}]]]}]
21:["$","aside",null,{"className":"mt-12 rounded-2xl border-l-4 border-accent bg-primary/5 p-7","children":[["$","p",null,{"className":"font-heading text-xl font-semibold","children":"The practical takeaway"}],["$","p",null,{"className":"mt-3 leading-7 text-muted-foreground","children":"Start with one meaningful learner outcome, create an authentic way to observe it, and support educators to improve the experience together."}]]}]
