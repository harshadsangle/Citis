1a:["$","section",null,{"className":"container-site py-16 sm:py-24","children":[["$","$L17",null,{"children":["$","h2",null,{"className":"font-heading text-3xl font-semibold leading-tight tracking-tight text-balance sm:text-4xl","children":"Program Modules"}]}],["$","div",null,{"className":"mt-10","children":["$","div",null,{"className":"grid gap-6 lg:grid-cols-2","children":[["$","$L17","1. The Entrepreneur",{"delay":0,"children":["$","article",null,{"className":"h-full rounded-2xl border border-border bg-card p-7 shadow-sm","children":[["$","h3",null,{"className":"font-heading text-xl font-semibold","children":"1. The Entrepreneur"}],["$","div",null,{"className":"mt-5 space-y-5","children":[["$","p","The Entrepreneur module introduces learners to the fundamentals of entrepreneurship and the mindset required to recognize and pursue opportunities.",{"className":"text-sm leading-7 text-muted-foreground","children":"The Entrepreneur module introduces learners to the fundamentals of entrepreneurship and the mindset required to recognize and pursue opportunities."}],["$","p","Students explore opportunity identification, business fundamentals and the key functions of a business, including finance, marketing, sales and operations. The module also helps learners understand the difference between being an entrepreneur and an intrapreneur and the capabilities required to succeed in both environments.",{"className":"text-sm leading-7 text-muted-foreground","children":"Students explore opportunity identification, business fundamentals and the key functions of a business, including finance, marketing, sales and operations. The module also helps learners understand the difference between being an entrepreneur and an intrapreneur and the capabilities required to succeed in both environments."}]]}]]}]}],["$","$L17","2. Design Thinking for Innovation",{"delay":0.05,"children":["$","article",null,{"className":"h-full rounded-2xl border border-border bg-card p-7 shadow-sm","children"