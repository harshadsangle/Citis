b:[["$","article",null,{"children":[["$","header",null,{"className":"relative overflow-hidden border-b border-border bg-[#eef3f8] py-16 text-slate-900 sm:py-24","children":[["$","div",null,{"className":"absolute inset-0 opacity-70 [background-image:radial-gradient(circle_at_88%_12%,rgba(14,116,144,0.12),transparent_32%),radial-gradient(circle_at_10%_80%,rgba(37,99,235,0.10),transparent_36%)]"}],["$","div",null,{"className":"container-site relative","children":[["$","$L19",null,{"href":"/highlights/blogs","className":"inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-800","children":[["$","$L1a",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left size-4"}],"All articles"]}],["$","div",null,{"className":"mt-8 max-w-4xl","children":[["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors border-transparent bg-secondary/10 text-secondary dark:text-blue-300","children":"Education Technology"}],["$","h1",null,{"className":"mt-5 font-heading text-4xl leading-tight font-semibold tracking-tight text-balance text-slate-900 dark:text-slate-900 sm:text-5xl lg:text-6xl","children":"Learning Management System (LMS)"}],["$","p",null,{"className":"mt-6 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-600","children":"Are you an educational institution looking out to manage education courses through a centrally administered, comprehensive learning management system (LMS)? Partner with CITIS InfoTech, the leading LMS development…"}],["$","div",null,{"className":"mt-7 flex flex-wrap items-center gap-5 text-sm text-slate-600 dark:text-slate-500","children":[["$","span",null,{"children":"CITIS InfoTech Editorial"}],["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L1a",null,{"ref":"$undefined","iconNode":[["path",{"d":"M8 2v3","key":"1ioe