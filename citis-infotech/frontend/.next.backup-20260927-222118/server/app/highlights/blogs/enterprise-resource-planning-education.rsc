10:[["$","article",null,{"children":[["$","header",null,{"className":"relative overflow-hidden border-b border-border bg-[#eef3f8] py-16 text-slate-900 sm:py-24","children":[["$","div",null,{"className":"absolute inset-0 opacity-70 [background-image:radial-gradient(circle_at_88%_12%,rgba(14,116,144,0.12),transparent_32%),radial-gradient(circle_at_10%_80%,rgba(37,99,235,0.10),transparent_36%)]"}],["$","div",null,{"className":"container-site relative","children":[["$","$L1a",null,{"href":"/highlights/blogs","className":"inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-800","children":[["$","$L1b",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left size-4"}],"All articles"]}],["$","div",null,{"className":"mt-8 max-w-4xl","children":[["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors border-transparent bg-secondary/10 text-secondary dark:text-blue-300","children":"Education Technology"}],["$","h1",null,{"className":"mt-5 font-heading text-4xl leading-tight font-semibold tracking-tight text-balance text-slate-900 dark:text-slate-900 sm:text-5xl lg:text-6xl","children":"Enterprise Resource Planning (ERP) Solutions"}],["$","p",null,{"className":"mt-6 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-600","children":"Once run conventionally, today, the education sector demands an extensive set of modern and competitive tools and technologies that help educators augment academic and operational efficiency. Accordingly, ERP is…"}],["$","div",null,{"className":"mt-7 flex flex-wrap items-center gap-5 text-sm text-slate-600 dark:text-slate-500","children":[["$","span",null,{"children":"CITIS InfoTech Editorial"}],["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L1b",null,{"ref":"$undefined","iconNode":[["path",{"d":"M8 2v3","key":"1ioesn"}],["path",{"d":"M16 2v3","key":"otl347"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2","key":"h1oib"}],["path",{"d":"M3 9h18","key":"1pudct"}],["path",{"d":"M8 13h.01","key":"1sbv64"}],["path",{"d":"M12 13h.01","key":"y0uutt"}],["path",{"d":"M16 13h.01","key":"wip0gl"}],["path",{"d":"M8 17h.01","key":"p3bg7i"}],["path",{"d":"M12 17h.01","key":"p32p05"}],["path",{"d":"M16 17h.01","key":"ql8jdd"}]],"className":"lucide-calendar-days size-4"}],"17 June 2021"]}],["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L1b",null,{"ref":"$undefined","iconNode":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"M12 6v6l4 2","key":"mmk7yg"}]],"className":"lucide-clock size-4"}],"4 min read"]}]]}]]}]]}]]}],["$","div",null,{"className":"bg-[#e8edf5] dark:bg-slate-900","children":["$","div",null,{"className":"container-site grid gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-16 lg:py-20","children":[["$","div",null,{"className":"mx-auto max-w-3xl","children":[[["$","section","Overview",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Overview"}],[["$","p","Once run conventionally, today, the education sector demands an extensive set of modern and competitive tools and technologies that help educators augment academic and operational efficiency. Accordingly, ERP is looked at as a comprehensive solution allowing educators usher competence across the academic and operations vertical.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Once run conventionally, today, the education sector demands an extensive set of modern and competitive tools and technologies that help educators augment academic and operational efficiency. Accordingly, ERP is looked at as a comprehensive solution allowing educators usher competence across the academic and operations vertical."}],["$","p","At CITIS InfoTech, we are one of the leading customized ERP solution providers for the education sector. Our ERP solutions integrate the latest technologies, including the competencies of AI, ML, and Business Intelligence. They are a product of extensive research across the pain points and modern-day demands of the education sector.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"At CITIS InfoTech, we are one of the leading customized ERP solution providers for the education sector. Our ERP solutions integrate the latest technologies, including the competencies of AI, ML, and Business Intelligence. They are a product of extensive research across the pain points and modern-day demands of the education sector."}],"$L1c"]]}],"$L1d","$L1e","$L1f","$L20","$L21"],"$L22"]}],"$L23"]}]}]]}],"$L24","$L25"]
1c:["$","p","We nurture a team of extensively experienced and expert ERP developers that work relentlessly towards building customized yet sustainable academic and operational ERP solutions for the education sector. Our highly customized ERP solutions focus on creating academic and operational value in the form of enhanced productivity through automation, integration of smart technologies, and features optimized for your workflow and needs.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"We nurture a team of extensively experienced and expert ERP developers that work relentlessly towards building customized yet sustainable academic and operational ERP solutions for the education sector. Our highly customized ERP solutions focus on creating academic and operational value in the form of enhanced productivity through automation, integration of smart technologies, and features optimized for your workflow and needs."}]
1d:["$","section","What do our Academic and Operational ERP Cover?",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"What do our Academic and Operational ERP Cover?"}],[["$","p","At CITIS InfoTech, we provide end-to-end academic and operational ERP modules to serve as a one-stop-shop point for clients widely spread throughout the education sector.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"At CITIS InfoTech, we provide end-to-end academic and operational ERP modules to serve as a one-stop-shop point for clients widely spread throughout the education sector."}]]]}]
1e:["$","section","Academic Management",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Academic Management"}],[["$","p","Attendance Management: Our automated attendance management functionality helps you get accurate insights into staff and student attendance.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Attendance Management: Our automated attendance management functionality helps you get accurate insights into staff and student attendance."}],["$","p","Hostel Management: You can manage tasks such as mess, room reservation, hotel fee, hostel inventory, hostel admission, etc., through the hostel management functionality.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Hostel Management: You can manage tasks such as mess, room reservation, hotel fee, hostel inventory, hostel admission, etc., through the hostel management functionality."}],["$","p","Fee Management: Fee management allows your students to pay the fee online, access their course or academic information and helps you track real-time student fee status.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Fee Management: Fee management allows your students to pay the fee online, access their course or academic information and helps you track real-time student fee status."}],["$","p","Library Management: Get access to a full-fledged library management functionality and manage book availability, book transactions, and get real-time status of library assets.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Library Management: Get access to a full-fledged library management functionality and manage book availability, book transactions, and get real-time status of library assets."}],["$","p","Staff Management: Our staff management functionality integrates with your existing biometric system and simplifies tasks such as payroll management, track employee performance, employee self-service, leave management, and many others based on your needs.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Staff Management: Our staff management functionality integrates with your existing biometric system and simplifies tasks such as payroll management, track employee performance, employee self-service, leave management, and many others based on your needs."}],["$","p","Course Management: Our course management functionality enables you to manage various courses, their duration, fee, course administration. Also, you can manage the course time-table, course admission, course facilities, details of students enrolled for a particular course, etc.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Course Management: Our course management functionality enables you to manage various courses, their duration, fee, course administration. Also, you can manage the course time-table, course admission, course facilities, details of students enrolled for a particular course, etc."}]]]}]
1f:["$","section","Operational Management",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Operational Management"}],[["$","p","Reporting: Our reporting module enables comprehensive reporting to the management, track metrics in real-time, thus keeping the management informed about real-time facts and figures.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Reporting: Our reporting module enables comprehensive reporting to the management, track metrics in real-time, thus keeping the management informed about real-time facts and figures."}],["$","p","Availability of Real-Time Information: Our ERP operational management enables staff members and students to upload information and ensures the availability of real-time information whenever you require.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Availability of Real-Time Information: Our ERP operational management enables staff members and students to upload information and ensures the availability of real-time information whenever you require."}],["$","p","Informed Decision-Making: Comprehensive reporting and the availability of real-time information at all times empowers you with the ability to make informed decisions.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Informed Decision-Making: Comprehensive reporting and the availability of real-time information at all times empowers you with the ability to make informed decisions."}],["$","p","Inventory Management: The inventory management functionality enables a complete campus inventory management lifecycle through the control of purchase, stock transfer, stock details, stock consumption, stock availability management, etc.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Inventory Management: The inventory management functionality enables a complete campus inventory management lifecycle through the control of purchase, stock transfer, stock details, stock consumption, stock availability management, etc."}],["$","p","Centralized Database: At CITIS InfoTech, we facilitate a centralized database through our ERP solution. It enables you to store student and staff information, payroll, HR, administration, accounts information in a centralized database. Additionally, we create authority-based access levels for users to access student and staff information.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Centralized Database: At CITIS InfoTech, we facilitate a centralized database through our ERP solution. It enables you to store student and staff information, payroll, HR, administration, accounts information in a centralized database. Additionally, we create authority-based access levels for users to access student and staff information."}]]]}]
20:["$","section","Why Choose CITIS InfoTech for Academic and Operational CRM Solution?",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Why Choose CITIS InfoTech for Academic and Operational CRM Solution?"}],[["$","p","We give you several reasons to choose as your ERP solutions partner. Some of them include,",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"We give you several reasons to choose as your ERP solutions partner. Some of them include,"}],["$","p","Comprehensive service range: ERP Consulting, ERP Design and Development, ERP Testing, ERP Implementation, and ERP Support",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Comprehensive service range: ERP Consulting, ERP Design and Development, ERP Testing, ERP Implementation, and ERP Support"}]]]}]
21:["$","section","Highly customized, robust, and scalable ERP solutions for optimized productivity",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Highly customized, robust, and scalable ERP solutions for optimized productivity"}],[["$","p","The education sector is transforming, and so should your systems! CITIS InfoTech Academic and Operational ERP is one of the keys to achieving academic and operational excellence through a customized ERP solution. If you are an educator looking forward to bringing a transformation in your education ecosystem, connect with CITIS InfoTech at +91 20 2567 70 60, or write to us at support@citis.in. We would be happy to be your ERP partners.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"The education sector is transforming, and so should your systems! CITIS InfoTech Academic and Operational ERP is one of the keys to achieving academic and operational excellence through a customized ERP solution. If you are an educator looking forward to bringing a transformation in your education ecosystem, connect with CITIS InfoTech at +91 20 2567 70 60, or write to us at support@citis.in. We would be happy to be your ERP partners."}]]]}]
22:["$","aside",null,{"className":"mt-12 rounded-2xl border-l-4 border-accent bg-primary/5 p-7","children":[["$","p",null,{"className":"font-heading text-xl font-semibold","children":"The practical takeaway"}],["$","p",null,{"className":"mt-3 leading-7 text-muted-foreground","children":"Start with one meaningful learner outcome, create an authentic way to observe it, and support educators to improve the experience together."}]]}]
