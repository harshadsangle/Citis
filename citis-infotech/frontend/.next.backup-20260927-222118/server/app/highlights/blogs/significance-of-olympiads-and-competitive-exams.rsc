10:[["$","article",null,{"children":[["$","header",null,{"className":"relative overflow-hidden border-b border-border bg-[#eef3f8] py-16 text-slate-900 sm:py-24","children":[["$","div",null,{"className":"absolute inset-0 opacity-70 [background-image:radial-gradient(circle_at_88%_12%,rgba(14,116,144,0.12),transparent_32%),radial-gradient(circle_at_10%_80%,rgba(37,99,235,0.10),transparent_36%)]"}],["$","div",null,{"className":"container-site relative","children":[["$","$L1a",null,{"href":"/highlights/blogs","className":"inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-800","children":[["$","$L1b",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left size-4"}],"All articles"]}],["$","div",null,{"className":"mt-8 max-w-4xl","children":[["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-semibold transition-colors border-transparent bg-secondary/10 text-secondary dark:text-blue-300","children":"School Education"}],["$","h1",null,{"className":"mt-5 font-heading text-4xl leading-tight font-semibold tracking-tight text-balance text-slate-900 dark:text-slate-900 sm:text-5xl lg:text-6xl","children":"Significance of Olympiads and Competitive Exams"}],["$","p",null,{"className":"mt-6 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-600","children":"NEP 2020 is considered a comprehensive modern-age educational policy that gives equal justice to every education dimension. It aims at creating a generation that isn’t just technologically aligned to meet global…"}],["$","div",null,{"className":"mt-7 flex flex-wrap items-center gap-5 text-sm text-slate-600 dark:text-slate-500","children":[["$","span",null,{"children":"CITIS InfoTech Editorial"}],["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L1b",null,{"ref":"$undefined","iconNode":[["path",{"d":"M8 2v3","key":"1ioesn"}],["path",{"d":"M16 2v3","key":"otl347"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2","key":"h1oib"}],["path",{"d":"M3 9h18","key":"1pudct"}],["path",{"d":"M8 13h.01","key":"1sbv64"}],["path",{"d":"M12 13h.01","key":"y0uutt"}],["path",{"d":"M16 13h.01","key":"wip0gl"}],["path",{"d":"M8 17h.01","key":"p3bg7i"}],["path",{"d":"M12 17h.01","key":"p32p05"}],["path",{"d":"M16 17h.01","key":"ql8jdd"}]],"className":"lucide-calendar-days size-4"}],"3 March 2022"]}],["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L1b",null,{"ref":"$undefined","iconNode":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"M12 6v6l4 2","key":"mmk7yg"}]],"className":"lucide-clock size-4"}],"6 min read"]}]]}]]}]]}]]}],["$","div",null,{"className":"bg-[#e8edf5] dark:bg-slate-900","children":["$","div",null,{"className":"container-site grid gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-16 lg:py-20","children":[["$","div",null,{"className":"mx-auto max-w-3xl","children":[[["$","section","Overview",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Overview"}],[["$","p","NEP 2020 is considered a comprehensive modern-age educational policy that gives equal justice to every education dimension. It aims at creating a generation that isn’t just technologically aligned to meet global demands but is self-driven, skilled, and responsible enough to make valuable contributions to society.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"NEP 2020 is considered a comprehensive modern-age educational policy that gives equal justice to every education dimension. It aims at creating a generation that isn’t just technologically aligned to meet global demands but is self-driven, skilled, and responsible enough to make valuable contributions to society."}],["$","p","The NEP 2020 includes many widespread changes and modifications to the country’s educational system. One of the most crucial ones is the inclusion of Olympiads and competitive exams. NEP 2020 intends to hone the talent of students by encouraging participation in Olympiads and competitive exams. The general belief driving this change is that it will prepare students for higher-level competitive exams and augment the country’s talent base.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"The NEP 2020 includes many widespread changes and modifications to the country’s educational system. One of the most crucial ones is the inclusion of Olympiads and competitive exams. NEP 2020 intends to hone the talent of students by encouraging participation in Olympiads and competitive exams. The general belief driving this change is that it will prepare students for higher-level competitive exams and augment the country’s talent base."}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21"]]}],"$L22","$L23","$L24","$L25","$L26","$L27"],"$L28"]}],"$L29"]}]}]]}],"$L2a","$L2b"]
1c:["$","p","This blog highlights what NEP 2020 has to say about Olympiads and competitive exams. It also discusses the significance of these competitive assessment platforms and indicates the purpose and vision that encouraged the policy-makers to emphasize their inclusion in the education stream.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"This blog highlights what NEP 2020 has to say about Olympiads and competitive exams. It also discusses the significance of these competitive assessment platforms and indicates the purpose and vision that encouraged the policy-makers to emphasize their inclusion in the education stream."}]
1d:["$","p","What does the NEP 2020 have to say about Olympiads and Competitive Exams?",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"What does the NEP 2020 have to say about Olympiads and Competitive Exams?"}]
1e:["$","p","NEP 2020 talks about competitive exams and Olympiads in the Support for Gifted Students / Students with Special Talents section. It emphasizes conducting Olympiads and competitions in various subjects and suggests clear coordination and progression from school to local to state and then finally to the national level to encourage and ensure participation of Indian students across all levels of the concerned competition.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"NEP 2020 talks about competitive exams and Olympiads in the Support for Gifted Students / Students with Special Talents section. It emphasizes conducting Olympiads and competitions in various subjects and suggests clear coordination and progression from school to local to state and then finally to the national level to encourage and ensure participation of Indian students across all levels of the concerned competition."}]
1f:["$","p","It also intends to make focused efforts to help competitive contests reach every corner of the country and make these exams and competitions available in regional languages to drive rural participation. Besides, public and private universities, including leading institutions such as NITs and IITs, would be encouraged to use merit-oriented results from National and International Olympiads and other relevant national programs as a part of their selection criteria for their undergraduate programs.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"It also intends to make focused efforts to help competitive contests reach every corner of the country and make these exams and competitions available in regional languages to drive rural participation. Besides, public and private universities, including leading institutions such as NITs and IITs, would be encouraged to use merit-oriented results from National and International Olympiads and other relevant national programs as a part of their selection criteria for their undergraduate programs."}]
20:["$","p","Nevertheless, to achieve the above objectives, technology, and the internet must reach every corner and every home. Once the entire country gets access to technology, we can develop online quiz apps, assessments, competitions, enrichment content, and online communities for shared interests. Students can collaborate and indulge in group activities under their parents’ and teachers’ supervision.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Nevertheless, to achieve the above objectives, technology, and the internet must reach every corner and every home. Once the entire country gets access to technology, we can develop online quiz apps, assessments, competitions, enrichment content, and online communities for shared interests. Students can collaborate and indulge in group activities under their parents’ and teachers’ supervision."}]
21:["$","p","Besides, schools will develop smart, technology-based classrooms to leverage digital pedagogy and enhance the teaching-learning process through online resources and comprehensive collaborations.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Besides, schools will develop smart, technology-based classrooms to leverage digital pedagogy and enhance the teaching-learning process through online resources and comprehensive collaborations."}]
22:["$","section","Why are Olympiads and Competitive Exams Crucial for Students?",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Why are Olympiads and Competitive Exams Crucial for Students?"}],[["$","p","In India, the Olympiad exams are conducted by SOF (Science Olympiad Foundation), a New Delhi-based non-profit organization. SOF conducts Olympiads to promote subjects such as mathematics, science, introductory computer education, general knowledge, and English. These exams are conducted for students from class 1 to 12. The six Olympiads conducted by SOF include,",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"In India, the Olympiad exams are conducted by SOF (Science Olympiad Foundation), a New Delhi-based non-profit organization. SOF conducts Olympiads to promote subjects such as mathematics, science, introductory computer education, general knowledge, and English. These exams are conducted for students from class 1 to 12. The six Olympiads conducted by SOF include,"}]]]}]
23:["$","section","International General Knowledge Olympiad (IGKO)",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"International General Knowledge Olympiad (IGKO)"}],[["$","p","Now, speaking of competitive exams. Again, you’ve got a range of competitive exams conducted every year to select individuals and assess them across various subject matters and competencies. Some of the popular competitive exams include the following,",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Now, speaking of competitive exams. Again, you’ve got a range of competitive exams conducted every year to select individuals and assess them across various subject matters and competencies. Some of the popular competitive exams include the following,"}]]]}]
24:["$","section","Maharashtra Common Entrance Test and many others",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Maharashtra Common Entrance Test and many others"}],[["$","p","Now, let us talk about the significance and relevance of these exams in the modern context. We live in a competitive age wherein developing exceptional skills, talent, understanding, and encouraging the natural flair towards a particular subject matter a lot. However, in a lot of cases, these skills go unnoticed, thus restricting the individual to a specific capability or compelling him or her to choose something against their natural liking.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Now, let us talk about the significance and relevance of these exams in the modern context. We live in a competitive age wherein developing exceptional skills, talent, understanding, and encouraging the natural flair towards a particular subject matter a lot. However, in a lot of cases, these skills go unnoticed, thus restricting the individual to a specific capability or compelling him or her to choose something against their natural liking."}],["$","p","A bad or unfavorable beginning is likely to deliver an undesirable result. It results in less productive and less engaged professionals. Besides, the regular curriculum does not give such people the opportunity to learn something they like in detail and get a better and exceptional understanding of the subject of their choice.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"A bad or unfavorable beginning is likely to deliver an undesirable result. It results in less productive and less engaged professionals. Besides, the regular curriculum does not give such people the opportunity to learn something they like in detail and get a better and exceptional understanding of the subject of their choice."}],["$","p","At an individual level, it may not matter as much. But the nation indeed suffers on the productivity and results front. A lot of such people do not deliver results, and when such people are in millions, you cannot expect to create value from the talent you have and plan to make vital contributions to the nation’s progress.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"At an individual level, it may not matter as much. But the nation indeed suffers on the productivity and results front. A lot of such people do not deliver results, and when such people are in millions, you cannot expect to create value from the talent you have and plan to make vital contributions to the nation’s progress."}]]]}]
25:["$","section","Importance of Olympiads and Competitive Exams",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Importance of Olympiads and Competitive Exams"}],[["$","p","It is here that Olympiads and competitive exams, encouraging students to participate in them and developing the necessary infrastructure, approach, and vision aligned with futuristic demands, come into the picture.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"It is here that Olympiads and competitive exams, encouraging students to participate in them and developing the necessary infrastructure, approach, and vision aligned with futuristic demands, come into the picture."}],["$","p","Olympiads, in particular, help to identify an individual’s capability and the real potential to deliver value from the talent or she holds. They encourage students to get a better and deeper understanding of a particular subject, develop analytical, problem-solving, and reasoning skills. Besides, they also point out the areas where a particular student requires improvement to, in turn, help teachers, educators, and parents to work towards it.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Olympiads, in particular, help to identify an individual’s capability and the real potential to deliver value from the talent or she holds. They encourage students to get a better and deeper understanding of a particular subject, develop analytical, problem-solving, and reasoning skills. Besides, they also point out the areas where a particular student requires improvement to, in turn, help teachers, educators, and parents to work towards it."}],["$","p","The skills that students develop while preparing for Olympiads and competitive exams help the student in the long run. Such students remain focused on learners and become dedicated contributors. The problem-solving, analytical, and excellent reasoning skills they develop while studying for these examinations make them more productive and enable them to deliver better results than their average counterparts.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"The skills that students develop while preparing for Olympiads and competitive exams help the student in the long run. Such students remain focused on learners and become dedicated contributors. The problem-solving, analytical, and excellent reasoning skills they develop while studying for these examinations make them more productive and enable them to deliver better results than their average counterparts."}],["$","p","Through meticulous planning and execution of NEP 2020’s roadmap, India can achieve the vision and objectives governing the inclusion and encouragement of Olympiads and competitive exams in the Indian education system. It will help the country develop a competitive, productive, engaged, result-oriented, and happier generation, willing to undertake challenges and create innovative solutions to overcome them.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Through meticulous planning and execution of NEP 2020’s roadmap, India can achieve the vision and objectives governing the inclusion and encouragement of Olympiads and competitive exams in the Indian education system. It will help the country develop a competitive, productive, engaged, result-oriented, and happier generation, willing to undertake challenges and create innovative solutions to overcome them."}],"$L2c","$L2d","$L2e"]]}]
26:["$","section","Inculcate the importance of hard work and the in-depth study of something",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Inculcate the importance of hard work and the in-depth study of something"}],[["$","p","Improve soft skills and develop the approach to study for career enhancement and not just passing examinations",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Improve soft skills and develop the approach to study for career enhancement and not just passing examinations"}],["$","p","Foster an improvement in the academic performance of the child by enhancing his or her grasping skills",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Foster an improvement in the academic performance of the child by enhancing his or her grasping skills"}],["$","p","Develop an approach to stay competitive and deliver the best at every cost",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Develop an approach to stay competitive and deliver the best at every cost"}]]]}]
27:["$","section","Conclusion",{"className":"mb-10","children":[["$","h2",null,{"className":"font-heading text-2xl font-semibold sm:text-3xl","children":"Conclusion"}],[["$","p","Proper execution of the NEP 2020 will undoubtedly bring results envisaged by the government. However, to do so, educators, especially schools, must step forward, develop synergies, and leverage the collective power of the educational ecosystem to execute every necessary recommendation of NEP 2020. Here, the objective must be to create a generation that is excellence-driven and not exam-oriented.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"Proper execution of the NEP 2020 will undoubtedly bring results envisaged by the government. However, to do so, educators, especially schools, must step forward, develop synergies, and leverage the collective power of the educational ecosystem to execute every necessary recommendation of NEP 2020. Here, the objective must be to create a generation that is excellence-driven and not exam-oriented."}],["$","p","CITIS, one of the leading EduTech companies in India, works with several schools to help them implement various such programs, including Olympiads and competitive exams. CITIS’s team ensures end-to-end execution of various Olympiads and tech-based certification programs. It provides competence and helps the school to be a value creator and a better contributor to the country's education landscape. For more details, call CITIS at +91 20 2567 70 60.",{"className":"mt-5 text-base leading-8 text-muted-foreground","children":"CITIS, one of the leading EduTech companies in India, works with several schools to help them implement various such programs, including Olympiads and competitive exams. CITIS’s team ensures end-to-end execution of various Olympiads and tech-based certification programs. It provides competence and helps the school to be a value creator and a better contributor to the country's education landscape. For more details, call CITIS at +91 20 2567 70 60."}]]]}]
28:["$","aside",null,{"className":"mt-12 rounded-2xl border-l-4 border-accent bg-primary/5 p-7","children":[["$","p",null,{"className":"font-heading text-xl font-semibold","children":"The practical takeaway"}],["$","p",null,{"className":"mt-3 leading-7 text-muted-foreground","children":"Start with one meaningful learner outcome, create an authentic way to observe it, and support educators to improve the experience together."}]]}]
