NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/citis_infotech
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_DOMAIN=
# Local disk uploads (no Cloudinary or paid CDN)
UPLOADS_DIR=./uploads
# Leave SMTP_HOST empty to log emails to the console (no external mail service).
# Optional free local catcher: Mailpit on localhost:1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CITIS InfoTech <noreply@localhost>
ADMIN_EMAIL=admin@localhost
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-seeding
