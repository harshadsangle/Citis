HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# Generate independent random values; APP_KEYS is comma-separated.
APP_KEYS=replace-key-1,replace-key-2,replace-key-3,replace-key-4
API_TOKEN_SALT=replace-with-a-long-random-value
ADMIN_JWT_SECRET=replace-with-a-long-random-value
TRANSFER_TOKEN_SALT=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-long-random-value

# sqlite (default) or postgres
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=citis_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
DATABASE_SCHEMA=public

# Comma-separated origins used by middleware/CORS configuration.
CLIENT_URL=http://localhost:3000
